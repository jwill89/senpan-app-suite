# The systemd unit for the Senpan App Suite backend. Every app deploy installs it at
# /etc/systemd/system/<service>.service where it differs from the live one, and puts the
# previous one back if the new build does not come up. The service's name, its account,
# the folder holding its binary and data, its loopback address and its env file are the
# double-underscore placeholders below, filled in from the untracked deploy config, so
# nothing about the host is in this file. Change the unit here, never on the host.

[Unit]
Description=Senpan App Suite Service
Documentation=https://github.com/jwill89
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
# A dedicated, unprivileged system account: nothing here needs root. It stays a fixed
# User= (never DynamicUser=) because the daily database backup runs as it and it owns the
# database.
User=__USER__
Group=__USER__
WorkingDirectory=__OPT__
# Secrets (the Turnstile secret, the session secret) are variables of this root-only file.
# An Environment= line is shown to any local user by `systemctl show` and is readable in
# /proc/<pid>/environ. The leading `-` is left off so a missing file stops the start: a
# service that came up without it would run with the Turnstile bot check switched off.
# Each APPSUITE_* variable is the fallback of the flag it is named for (-turnstile-secret,
# -cors-origins, ...).
EnvironmentFile=__ENVFILE__
# -data is the data folder: the uploads (images/, fonts/, carrd/), the plugin repository
# (plugin/) and the sounds (sounds/), beside the database. The app serves its public files
# itself; nothing of it is under a web server's document root.
ExecStart=__OPT__/app-suite -addr __ADDR__ -db __OPT__/data/database.sqlite -data __OPT__/data

# Restart on failure after 5 seconds; five starts within 60 seconds stop the retries.
Restart=on-failure
RestartSec=5

# Hardening. These sandbox the service so a compromise of the process has minimal reach:
# no privilege escalation, a read-only filesystem except ReadWritePaths below, no access
# to /home, a private /tmp and /dev, and a locked-down kernel, namespace and syscall
# surface. Loosen one only with the app change that needs it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# TCP (the listen address) and local sockets for DNS.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# A Go network daemon needs nothing outside the standard service syscall set.
SystemCallFilter=@system-service
# Reject any non-native syscall ABI, so the filter above and W^X below can't be bypassed
# through a secondary architecture's calling convention.
SystemCallArchitectures=native
# W^X: forbid writable-executable mappings, which blocks classic code injection. Safe here
# because nothing in the binary generates code at run time: it is pure Go with no cgo, and
# so is the SQLite driver (modernc.org/sqlite: SQLite's C translated to Go ahead of time),
# so SQLite runs from the read-only .text segment. A driver that does generate code (a
# WebAssembly SQLite under a JIT, say) would crash on this with SIGSYS, and this line
# would have to go.
MemoryDenyWriteExecute=yes

# Everything the app writes is in the data folder: the database (with its -wal and -shm),
# the uploads, the fonts, the Carrd projects and the plugin repository. The binary beside
# it stays read-only to the service, so a compromised process cannot replace its own code.
# A path written outside this list fails with EACCES under ProtectSystem=strict.
ReadWritePaths=__OPT__/data
# Creates /var/log/senpan (owned by the service user) and keeps it writable under
# ProtectSystem=strict: the folder of the app's default -log-file. journald still gets
# stdout and stderr below.
LogsDirectory=senpan

# Logging (stdout and stderr go to journalctl)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=__SERVICE__

[Install]
WantedBy=multi-user.target
