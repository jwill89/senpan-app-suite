<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for everything in the plugin that does not touch the game: the generated client
    and its reading, the live stream's reader, the back-off, the wording of a refusal and
    the raffle pricing. The sources are compiled in from the plugin rather than referenced,
    so this builds and runs with no Dalamud on the machine, which is what lets CI run it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SenpanCompanion\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\SenpanCompanion\Api\**\*.cs" LinkBase="Api" />
    <!-- Answers shaped as the API document declares them, nulls and all. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dalamud provides this to the plugin itself. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
