# The Font Awesome Pro kit (@awesome.me) and packages (@fortawesome) come from Font
# Awesome's registry. The account's package token lives outside the repo: in ~/.npmrc
# locally, and in the FONTAWESOME_TOKEN secret for CI, which writes it to ~/.npmrc
# before npm ci.
@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/

# Local packages (the shared-tooling submodule's lint/web) install as copies, so their
# own dependencies come with them; a link would leave ESLint unable to find its plugins.
install-links=true
