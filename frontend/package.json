{
  "name": "app-suite-frontend",
  "private": true,
  "version": "3.31.0",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "lint:check": "eslint . && stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint:conventions": "node scripts/check-conventions.mjs",
    "lint:conventions:baseline": "node scripts/check-conventions.mjs --update-baseline",
    "analyze": "cross-env ANALYZE=true vue-tsc -b && cross-env ANALYZE=true vite build",
    "gen:types": "cd ../backend && go run github.com/gzuidhof/tygo@v0.2.21 generate"
  },
  "dependencies": {
    "@awesome.me/kit-46204fb6f1": "^1.0.3",
    "@ckpack/vue-color": "^1.6.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@milkdown/crepe": "^7.23.0",
    "@tanstack/vue-table": "^9.3.1",
    "html-to-image": "^1.11.13",
    "konva": "^10.9.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
    "vue3-emoji-picker": "^1.1.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "js-beautify": {
      "glob": "^13.0.0"
    }
  }
}
