# EditorConfig for the Senpan Companion plugin - the repo's only C# project.
#
# Its job is to pin the C# formatting and code-style rules that `dotnet format`
# (run in CI) and the build enforce, so the formatter agrees with the code as
# written rather than the other way around. Scoped to this folder via `root = true`,
# so it has no effect on the Go/TS code elsewhere in the repo.
#
# The formatting options and the case-block rule below are the ones the existing
# code already satisfied; the code-style rules after them are the shared standard
# from the sister Kindred Nights plugin. `end_of_line` is intentionally left UNSET -
# the repo normalizes text to LF (.gitattributes `eol=lf`), so CI checks out LF while
# a Windows working tree may hold CRLF; leaving it unset lets `dotnet format`
# preserve each file's existing endings instead of failing on one platform.
root = true

[*.cs]
indent_style = space
indent_size = 4

# Braced `case` blocks keep their `{` aligned with the `case` label instead of
# indented an extra level. This matches the switch style used in the plugin
# (e.g. LiveConnection.HandleMessage). `dotnet format`'s default for this option
# is `true`, which would otherwise want the whole block reflowed one level deeper.
csharp_indent_switch_labels = true
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false

# -- Code style --
# The .NET conventions, in the style the plugin is written in, which is Dalamud's own:
# `this.` on members, `var`, file-scoped namespaces, usings outside them, braces on any
# body of more than one line, private fields in camelCase. The build reports a departure
# as a warning (EnforceCodeStyleInBuild, SenpanCompanion.csproj), which the gate's
# TreatWarningsAsErrors turns into a failure, and CI fails on any change `dotnet format`
# would make.
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_prefer_braces = when_multiline:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:warning
# Unused usings.
dotnet_diagnostic.IDE0005.severity = warning
# A private field is camelCase; a constant or a static readonly one is PascalCase, as .NET writes them.
dotnet_naming_rule.private_constants.symbols = private_constants
dotnet_naming_rule.private_constants.style = pascal_case
dotnet_naming_rule.private_constants.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_rule.private_statics.symbols = private_statics
dotnet_naming_rule.private_statics.style = pascal_case
dotnet_naming_rule.private_statics.severity = warning
dotnet_naming_symbols.private_statics.applicable_kinds = field
dotnet_naming_symbols.private_statics.applicable_accessibilities = private
dotnet_naming_symbols.private_statics.required_modifiers = static, readonly
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = camel_case
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case
# The documentation file exists only so the build can report unused usings (IDE0005);
# a doc comment is written where the name does not already say it, so one that
# documents some parameters need not document all, and an undocumented member is fine.
dotnet_diagnostic.CS1573.severity = none
dotnet_diagnostic.CS1591.severity = none

# -- Lint rule severities --
# Read by the `roslynator analyze` gate (scripts/check.ps1) as well as the build and
# IDE. This is where the C# lint ruleset is curated, the way .golangci.yml curates the
# Go linters - disable a rule here (with a reason) when it doesn't fit the project.
#
# The one winmm P/Invoke (WinnerChime) works fine as a classic [DllImport]; don't
# require rewriting it to source-generated [LibraryImport] for a one-shot chime.
dotnet_diagnostic.SYSLIB1054.severity = none
