{
  "name": "app-suite-frontend",
  "private": true,
  "version": "5.4.0",
  "type": "module",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "lint:check": "eslint . && stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write src/ e2e/ playwright.config.ts",
    "format:check": "prettier --check src/ e2e/ playwright.config.ts",
    "lint:conventions": "node scripts/check-conventions.mjs",
    "lint:conventions:baseline": "node scripts/check-conventions.mjs --update-baseline",
    "analyze": "cross-env ANALYZE=true vue-tsc -b && cross-env ANALYZE=true vite build"
  },
  "dependencies": {
    "@awesome.me/kit-46204fb6f1": "^1.0.9",
    "@ckpack/vue-color": "^1.6.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@milkdown/crepe": "^7.23.0",
    "@tanstack/vue-table": "^9.3.1",
    "html-to-image": "^1.11.13",
    "konva": "^10.9.1",
    "markdown-it": "^15.0.3",
    "openapi-fetch": "0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.5.0",
    "vue3-emoji-picker": "^2.1.0"
  },
  "devDependencies": {
    "@jwill89/lint-web": "file:../shared/lint/web",
    "@jwill89/test-a11y": "file:../shared/test/a11y",
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "js-beautify": {
      "glob": "^14.0.2"
    },
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "workbox-build": {
      "glob": "^14.0.2"
    }
  }
}
