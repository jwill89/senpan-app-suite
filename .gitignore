# Runtime data & local tooling
# Anchored to repo root so the rule doesn't also catch nested dirs like
# plugins/SenpanCompanion/Data/ (git is case-insensitive on Windows).
/devdata/
.idea/
.vscode/
vendor/
node_modules/
*.sqlite
*.sqlite-shm
*.sqlite-wal
test_cookies.txt

# Built Go binaries
/backend/app-suite
/backend/app-suite.exe
*.exe

# Frontend (Vite) build output & deps. The build goes where the Go binary embeds it
# (backend/internal/web/dist).
frontend/node_modules/
backend/internal/web/dist/
frontend/dist/
frontend/stats.html
frontend/.vite/
frontend/*.tsbuildinfo

# Task's checksums for build:web's sources (Taskfile.yml).
.task/
frontend/coverage/
# Playwright's traces of a failed end-to-end run.
frontend/test-results/
frontend/playwright-report/

# CI report artifacts (JUnit test reports + golangci-lint Code Quality), produced
# by the pipeline (and if you run the CI commands locally).
/frontend/junit.xml
/backend/junit.xml
/backend/gl-code-quality-report.json

# Secrets - never commit credentials. systemd EnvironmentFiles, etc.
*.env
!*.env.example

# OS noise
Thumbs.db
.DS_Store
/deploy/images/favicon.png
/frontend/public/images/favicon.png
/deploy/images/logo.png
/frontend/public/images/logo.png
/deploy/images/share_banner.png
/frontend/public/images/share_banner.png
/.claude/launch.json
/frontend/public/images/called_flourish.svg
/deploy/images/apple-touch-icon.png
/deploy/images/called_flourish.svg
/deploy/images/corner_flourish.svg
/deploy/images/favicon.png
/deploy/images/logo.png
/deploy/images/pwa-192x192.png
/deploy/images/pwa-512x512.png
/deploy/images/pwa-maskable-512x512.png
/frontend/public/images/apple-touch-icon.png
/frontend/public/images/corner_flourish.svg
/frontend/public/images/pwa-192x192.png
/frontend/public/images/pwa-512x512.png
/frontend/public/images/pwa-maskable-512x512.png
/CURRENT_THEMES.css
# Ignore ONLY the genuine secret under scripts/: the deploy script's
# environment-specific host + key live in scripts/deploy.config.ps1 (dot-sourced
# at runtime). Everything else in scripts/ holds no secrets and stays tracked. Do NOT
# broaden this to /scripts/* - that silently drops new scripts from version control.
/scripts/deploy.config.ps1
/frontend/public/sounds/
/frontend/public/images/flourishes/corner_flourish.svg
/frontend/public/images/flourishes/called_flourish.svg
plans/release-e*
