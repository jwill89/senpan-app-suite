{
  // The shared app settings (`@jwill89/lint-web`): Vue's DOM base, unused locals and
  // parameters, switch fallthrough, and an index that may find nothing typed as such.
  "extends": "@jwill89/lint-web/tsconfig.app.json",
  "compilerOptions": {
    /* Path alias (resolved relative to this tsconfig; baseUrl is unneeded under
       moduleResolution "bundler" and deprecated as of TS 6). */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "env.d.ts", "vitest.setup.ts"]
}
