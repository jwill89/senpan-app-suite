# ============================================================================
# Apache .htaccess - App Suite production document root (4.0.0 on)
# ----------------------------------------------------------------------------
# The app deploy writes this file to the DocumentRoot (NOT into a subfolder), with
# __APP__ replaced by the address the app listens on: the -addr on the service's
# ExecStart (127.0.0.1:<port>). Edit it here; each app deploy replaces the live one,
# keeping the previous in .deploy-backup until the site passes its checks.
#
# The Go binary serves the app: the API and, since 4.0.0, the SPA it embeds
# (backend/internal/web), with the SPA's headers, cache rules and
# Content-Security-Policy. The vhost's ProxyPass sends /api/ (the WebSocket included)
# to it before this file runs; this file sends it everything else that isn't one of
# the web root's own folders.
#
# Expected layout at the DocumentRoot:
#
#   <DocumentRoot>/
#   +-- .htaccess    <- this file
#   +-- images/      <- PERSISTENT static + uploaded images (raffles, categories)
#   +-- fonts/       <- uploaded fonts, refused here (fonts/.htaccess); the API streams them
#   +-- carrd/       <- the Carrd sites (carrd/.htaccess)
#   \-- plugin/      <- the Dalamud custom repository (plugin/.htaccess)
#
# The Go server runs with `-webroot <DocumentRoot>`, so its uploads land in those
# folders. dist/, where the SPA was served from before 4.0.0, is no longer read: once
# 4.0.0 has stayed, remove it and its rollback copy dist.old (deploy/README.md).
# ============================================================================

# Never expose a directory listing if a rewrite rule is ever skipped (e.g.
# mod_rewrite disabled) - return 403 instead of leaking the folder contents.
Options -Indexes

# Deny every dotfile. This is an authorization directive (independent of
# mod_rewrite), so it applies even though the "^images/ - [L]" rewrite below
# serves the images/ tree as real files. In particular it hides
# images/.categories.json - the image-category manifest, which enumerates every
# category name and directory. The list API keeps that behind auth; without this
# block an unauthenticated GET /images/.categories.json would leak the same data.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never rewrite API / WebSocket requests - the vhost ProxyPass handles them.
    RewriteRule ^api/ - [L]

    # The web root's own folders, served as they are (a missing file there is a 404).
    RewriteRule ^(images|carrd|plugin)/ - [L]

    # Any other real file in the web root, as before 4.0.0.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else is the app's: its pages, its hashed assets, its sounds.
    RewriteRule ^(.*)$ http://__APP__/$1 [P,L]
</IfModule>

# ----------------------------------------------------------------------------
# Security headers for what Apache serves itself, the web root's folders. The app sets
# its own on everything it answers, so they are not set twice on a proxied response.
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/(images|carrd|plugin)/#">
        # Don't let browsers MIME-sniff a response into a different type. Pairs with
        # the server's extension+magic-byte upload checks: an image that somehow slips
        # through still won't be interpreted as HTML/script.
        Header always set X-Content-Type-Options "nosniff"
        # Clickjacking: refuse to be framed.
        Header always set X-Frame-Options "DENY"
        # Trim the Referer sent to other origins.
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS: every subdomain is confirmed HTTPS-only. Sticky: browsers cache it for
        # the max-age and it's hard to undo.
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </If>
</IfModule>
